# TDX secrets — supplied at build time via --dart-define-from-file
tdx.env.json
*.env.json
lib/config/tdx_credentials.dart

# Secrets / env
.env
*.env
proxy/.dev.vars

# Android signing — never commit the keystore or its passwords
android/key.properties
*.jks
*.keystore

# Node / Wrangler (TDX proxy)
proxy/node_modules/
proxy/.wrangler/

# Flutter build outputs
/build/

# Dart tool cache
.dart_tool/

# IntelliJ IDE
.idea/

# Flutter plugin files
.flutter-plugins
.flutter-plugins-dependencies