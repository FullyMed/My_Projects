# Copy this file to android/key.properties and fill in real values.
# android/key.properties is gitignored — never commit it or the .jks file.
#
# Generate an upload keystore once:
#   keytool -genkey -v -keystore upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Store upload-keystore.jks OUTSIDE the repo and point storeFile at it.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=C:\\Users\\felix\\keys\\taiwan-fare-finder-upload.jks
