// Copy this file to tdx_credentials.dart and fill in your TDX credentials.
// Never commit the real tdx_credentials.dart — it is gitignored.
// Register for free at https://tdx.transportdata.tw/
//
// PREFERRED: don't ship these at all. Deploy the Cloudflare Worker in `proxy/`
// and run the app with:
//   --dart-define=TFF_PROXY_BASE_URL=https://<your-worker>/api/basic/v2
// The proxy holds the secret server-side; the app then ignores this file.
//
// These constants are only used for LOCAL DEVELOPMENT when no proxy URL is set.
// A release build that embeds them exposes the secret in the binary.

const tdxClientId = 'YOUR_CLIENT_ID';
const tdxClientSecret = 'YOUR_CLIENT_SECRET';
