# Prambanan Batik — web-server hardening
# These rules are defense-in-depth alongside the security headers already
# sent from PHP in config.php. If this host disables .htaccess overrides
# (AllowOverride None), the PHP-level headers still apply on every request
# that reaches PHP, but the file-blocking rules below will not.

# ── Disable directory listing ────────────────────────────────────────────
Options -Indexes -MultiViews
ServerSignature Off

# ── Custom 404 page ────────────────────────────────────────────────────────
# ErrorDocument paths are resolved from the server DocumentRoot, not from this
# file's directory, so this must match SITE_PATH (see config.php): the
# subdirectory prefix below is correct for local XAMPP/WAMP dev
# (http://localhost/Prambanan_Batik/). When deployed at the domain root in
# production, change this to just "/404.php".
ErrorDocument 404 /Prambanan_Batik/404.php

# ── Force HTTPS in production (skipped for local XAMPP/WAMP dev) ─────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block every dot-file/dot-folder (.git, .env, .claude, .htaccess, …) except
    # .well-known (used by Let's Encrypt / security.txt).
    RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

    # robots.txt is generated by robots.php so its paths + Sitemap URL follow BASE_URL.
    RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>

# ── Security headers (mirrors config.php; also covers static assets) ─────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ── Static-asset browser caching ─────────────────────────────────────────
# styles.css / main.js / admin.css are linked with a ?v=<file mtime> cache-buster
# (asset_url() in functions.php, plus the same pattern in admin pages), so they
# can be cached for a year and still update instantly after a deploy. Images,
# fonts and icons have no version in their URL, so they get 30 days instead.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|webmanifest|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# ── Block direct web access to internal-only PHP includes ────────────────
# These files are only ever loaded via require/include and produce no
# output of their own; they should never be requested directly over HTTP.
<FilesMatch "^(config|db_connect|functions)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── Block access to secrets, data files, and project metadata ────────────
<FilesMatch "(^\.env.*|\.(sql|log|md|lock|bak)$|^composer\.(json|lock)$|^package(-lock)?\.json$|^CLAUDE\.md$|^Run\.txt$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
