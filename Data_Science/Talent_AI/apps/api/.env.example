SUPABASE_URL=https://ljtjlvyezkyakayetlod.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# Local dev value. On Cloud Run this ALSO includes the live Vercel URL --
# that value is prod-only and is never copied from this file. See
# CLAUDE.md "Environment" for why that distinction matters.
CORS_ORIGINS=http://localhost:3000
# Local dev value; Cloud Run's is the live Vercel URL. Same prod-only-value
# rule as CORS_ORIGINS above -- used to build Stripe Checkout's redirect URLs.
FRONTEND_URL=http://localhost:3000

# AI insights (Phase D) -- optional. Without OPENAI_API_KEY the insights
# endpoints return 503 and the rest of the API is unaffected.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Stripe billing (Phase D) -- optional. Without these, /billing/* returns 503.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# service_role key -- ONLY used by app/services/admin_client.py, for the
# Stripe webhook and the weekly-report scheduler (see CLAUDE.md). Never used
# for anything a signed-in user's own request could go through instead.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Weekly shortlist email digest (Phase E) -- optional. Without these,
# /internal/run-weekly-reports always 401s and email sends silently no-op.
REPORT_TRIGGER_SECRET=generate-with-openssl-rand-hex-32
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=a-gmail-app-password-not-your-real-password
SMTP_FROM=you@gmail.com
