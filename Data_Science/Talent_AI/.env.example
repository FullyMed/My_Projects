# Copy to .env and fill in.

# Phase 2 (LLM insights) — required for scripts/generate_insights.py and the
# dashboard's "Generate AI Insights" button.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Phase 4 (automation) — all optional. The scheduler and folder watcher work fine
# without these; SMTP is only needed if you want email notifications. Without it,
# scripts/run_automation.py logs "SMTP not configured, skipping" and keeps going.
SCHEDULE_INTERVAL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
RECRUITER_EMAIL=
